{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quartermaster",
  "version": "0.1.0",
  "identifier": "edu.byu.lifesciences.archive",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Quartermaster",
        "width": 1120,
        "height": 740,
        "minWidth": 780,
        "minHeight": 480,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 24 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../../dist/helpers/": "helpers/" },
    "category": "Utility",
    "shortDescription": "Move research data to and from the archive"
  }
}
